{
  "name": "dsh-lan-manager",
  "version": "0.1.0",
  "description": "LAN-scoped management API for DeepSeek Harness: list active workspaces and sessions, prompt specific or all sessions, and archive or delete them",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./net": "./src/net.js",
    "./api": "./src/api.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pummelchen/TinyTitan.git",
    "directory": "plugins/dsh-lan-manager"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test 'test/*.test.js'"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "lan",
    "cluster",
    "tinytitan"
  ]
}
